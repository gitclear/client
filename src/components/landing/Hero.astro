---
import GitInstaller from '../GitInstaller';
---

<section class="landing-section hero" id="top" data-grid="split" style="flex-shrink: 0; box-sizing: border-box; padding: 64px 120px 88px; display: grid; grid-template-columns: minmax(0, 1fr) 468px; gap: 72px; align-items: start">
  <div style="display: flex; flex-direction: column; gap: 28px; padding-top: 12px">
    <div style="font-family: 'Geist Mono', ui-monospace, monospace; font-size: 14px; color: var(--muted)">
      <span style="color: var(--accent)">@@ -2005 +2026 @@</span>&nbsp; git clients, re-diffed
    </div>
    <h1 style="margin: 0; font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-size: 92px; line-height: 0.96; letter-spacing: -0.02em; color: var(--ink)">Your git client was built for diffs a person <em style="font-style: italic; color: var(--accent)">typed.</em></h1>
    <p style="margin: 0; max-width: 690px; font-size: 20px; line-height: 1.55; color: var(--body)">Agents now open pull requests six times larger than a human's, and a standard diff still knows only two words: added and deleted. <strong style="color: var(--ink); font-weight: 600">Diff Digest</strong> is the next-generation git client. It reads every repo you're responsible for, ranks change by impact instead of by timestamp, and lets you ask Claude about any line.</p>
    <div style="display: flex; align-items: center; gap: 14px">
      <a href="https://www.gitclear.com/download_diff_digest" style="height: 56px; box-sizing: border-box; padding: 0 26px; display: flex; align-items: center; gap: 10px; border-radius: 12px; background: var(--ink); color: var(--on-solid); font-size: 17px; font-weight: 600; text-decoration: none">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>
        Download for macOS
        <span style="margin-left: 4px; padding: 3px 8px; border-radius: 6px; background: #2A2D35; font-size: 13px; font-weight: 500; color: #D8DAE0">Free</span>
      </a>
      <a href="/#tour" style="height: 56px; box-sizing: border-box; padding: 0 22px; display: flex; align-items: center; gap: 10px; border-radius: 12px; border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); font-size: 17px; font-weight: 500; text-decoration: none">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"></path></svg>
        Watch the tour
      </a>
    </div>
    <div style="font-family: 'Geist Mono', ui-monospace, monospace; font-size: 13px; color: var(--muted)">v0.3.11 · macOS 13+ on Apple Silicon · Linux &amp; Windows next · free forever on 10 repos</div>
    <div data-grid="three" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; margin-top: 12px; border-top: 1px solid var(--line)">
      <div style="padding: 22px 24px 0 0; display: flex; flex-direction: column; gap: 6px">
        <div style="font-family: 'Instrument Serif', Georgia, serif; font-size: 44px; line-height: 1">29%</div>
        <div style="font-size: 14px; line-height: 1.45; color: var(--muted)">less PR review time, measured across 49 developers</div>
      </div>
      <div style="padding: 22px 24px 0; display: flex; flex-direction: column; gap: 6px; border-left: 1px solid var(--line)">
        <div style="font-family: 'Instrument Serif', Georgia, serif; font-size: 44px; line-height: 1">6</div>
        <div style="font-size: 14px; line-height: 1.45; color: var(--muted)">change types instead of "added" and "deleted"</div>
      </div>
      <div style="padding: 22px 0 0 24px; display: flex; flex-direction: column; gap: 6px; border-left: 1px solid var(--line)">
        <div style="font-family: 'Instrument Serif', Georgia, serif; font-size: 44px; line-height: 1">0 bytes</div>
        <div style="font-size: 14px; line-height: 1.45; color: var(--muted)">of your source leave the machine. It runs offline.</div>
      </div>
    </div>
  </div>

  <!-- v1 git install window -->
  <GitInstaller client:load />
</section>
