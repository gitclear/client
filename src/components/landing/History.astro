---
import activity from '../../data/activity.json';
---

<section class="landing-section history" id="tour" style="flex-shrink: 0; box-sizing: border-box; padding: 24px 120px 120px; display: flex; flex-direction: column; gap: 40px">
  <div data-grid="split" style="display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: 72px; align-items: end">
    <div style="display: flex; flex-direction: column; gap: 16px">
      <div style="font-family: 'Geist Mono', ui-monospace, monospace; font-size: 13px; color: var(--accent)">01 · multi-repo history</div>
      <h2 style="margin: 0; font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-size: 64px; line-height: 1; letter-spacing: -0.015em">Every repo you're responsible for, in one scroll.</h2>
    </div>
    <p style="margin: 0; font-size: 17px; line-height: 1.6; color: var(--body)">Every other client opens on one repository's chronological commit graph. Diff Digest opens on a feed: ninety days of change across organizations and repos, ranked by how much work each commit represents.</p>
  </div>

  <figure style="margin: 0; display: flex; flex-direction: column; gap: 14px">
    <div style="position: relative; height: 700px; border: 1px solid var(--line-strong); border-radius: 20px; background: var(--surface); overflow: hidden; box-shadow: 0 30px 60px -40px rgba(21,23,28,0.35)">
      <div style="height: 44px; box-sizing: border-box; padding: 0 18px; display: flex; align-items: center; gap: 8px; border-bottom: 1px solid var(--line-soft); background: var(--surface-soft)">
        <span style="width: 12px; height: 12px; border-radius: 999px; background: #E36B5D"></span>
        <span style="width: 12px; height: 12px; border-radius: 999px; background: #E9B949"></span>
        <span style="width: 12px; height: 12px; border-radius: 999px; background: #6DBE6A"></span>
        <span style="flex-grow: 1; text-align: center; font-family: 'Geist Mono', ui-monospace, monospace; font-size: 12px; color: var(--muted)">diff-digest — browse — all organizations — last 90 days</span>
      </div>
      <div style="display: grid; grid-template-columns: 250px minmax(0, 1fr); height: 656px">
        <div style="box-sizing: border-box; padding: 20px 16px; border-right: 1px solid var(--line-soft); background: var(--surface-soft); display: flex; flex-direction: column; gap: 18px; font-size: 13px">
          <div style="font-family: 'Geist Mono', ui-monospace, monospace; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted)">Organizations</div>
          <div style="display: flex; flex-direction: column; gap: 4px">
            <div style="padding: 8px 10px; border-radius: 8px; background: #EAE6DC; display: flex; justify-content: space-between; font-weight: 600"><span>gitclear</span><span style="color: var(--muted); font-weight: 500">4 repos</span></div>
            <div style="padding: 8px 10px 8px 22px; display: flex; justify-content: space-between; color: var(--body)"><span>gitclear-rails</span><span style="color: var(--muted)">812</span></div>
            <div style="padding: 8px 10px 8px 22px; display: flex; justify-content: space-between; color: var(--body)"><span>diff-digest</span><span style="color: var(--muted)">604</span></div>
            <div style="padding: 8px 10px 8px 22px; display: flex; justify-content: space-between; color: var(--body)"><span>telemetry-hooks</span><span style="color: var(--muted)">131</span></div>
            <div style="padding: 8px 10px 8px 22px; display: flex; justify-content: space-between; color: var(--body)"><span>marketing-site</span><span style="color: var(--muted)">77</span></div>
            <div style="padding: 8px 10px; margin-top: 6px; border-radius: 8px; display: flex; justify-content: space-between; font-weight: 600"><span>amplenote</span><span style="color: var(--muted); font-weight: 500">2 repos</span></div>
            <div style="padding: 8px 10px 8px 22px; display: flex; justify-content: space-between; color: var(--body)"><span>amplenote-web</span><span style="color: var(--muted)">455</span></div>
            <div style="padding: 8px 10px 8px 22px; display: flex; justify-content: space-between; color: var(--body)"><span>plugins</span><span style="color: var(--muted)">96</span></div>
          </div>
          <div style="margin-top: auto; padding: 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); display: flex; flex-direction: column; gap: 8px">
            <div style="font-size: 12px; color: var(--muted)">Sort feed by</div>
            <div style="display: flex; gap: 4px; font-size: 12px; font-weight: 600">
              <span style="flex-grow: 1; text-align: center; padding: 6px 0; border-radius: 6px; background: var(--ink); color: var(--on-solid)">Impact</span>
              <span style="flex-grow: 1; text-align: center; padding: 6px 0; border-radius: 6px; color: var(--muted)">Time</span>
            </div>
          </div>
        </div>
        <div style="box-sizing: border-box; padding: 18px 28px; display: flex; flex-direction: column; gap: 6px; overflow: hidden">
          <div style="display: flex; justify-content: space-between; padding: 6px 0 10px; font-family: 'Geist Mono', ui-monospace, monospace; font-size: 12px; color: var(--muted); border-bottom: 1px solid var(--line-soft)"><span>TUE, SEP 22 · 6 repos · 38 commits</span><span>Diff Delta</span></div>
          {activity.map((r, index) => (
            <div class:list={["activity-row", { "activity-row-featured": index === 0 }]}>
              <span style="padding: 4px 9px; border-radius: 6px; background: var(--muted-surface); font-family: 'Geist Mono', ui-monospace, monospace; font-size: 12px; color: var(--body); white-space: nowrap">{r.repo}</span>
              <span style="font-size: 14px; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis">{r.msg}</span>
              <span style="font-size: 12px; color: var(--muted); white-space: nowrap">{r.who}</span>
              <span style="display: flex; align-items: center; gap: 10px; justify-content: flex-end">
                <span style="width: 140px; height: 8px; border-radius: 999px; background: var(--muted-surface); overflow: hidden; display: flex">
                  <span style={{ width: `${r.impact}%`, background: r.impact < 10 ? "var(--subtle)" : "var(--accent)" }}></span>
                </span>
                <span style="width: 44px; text-align: right; font-family: 'Geist Mono', ui-monospace, monospace; font-size: 13px; font-weight: 600">{r.dd}</span>
              </span>
            </div>
          ))}
        </div>
      </div>
      <!-- video overlay -->
      <div style="position: absolute; left: 0; right: 0; top: 44px; bottom: 0; display: flex; align-items: center; justify-content: center; background: rgba(246,244,239,0.28)">
        <div aria-hidden="true" class="preview-play" style="width: 104px; height: 104px; border: 0; border-radius: 999px; background: var(--ink); color: var(--on-solid); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 10px rgba(255,255,255,0.7)">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="margin-left: 5px"><path d="M7 4.5v15l13-7.5z"></path></svg>
        </div>
      </div>
      <div style="position: absolute; left: 20px; right: 20px; bottom: 18px; height: 44px; box-sizing: border-box; padding: 0 16px; border-radius: 12px; background: rgba(21,23,28,0.9); display: flex; align-items: center; gap: 14px; color: var(--on-solid); font-family: 'Geist Mono', ui-monospace, monospace; font-size: 12px">
        <span>Preview</span>
        <span style="flex-grow: 1; height: 4px; border-radius: 999px; background: #3A3E48; display: flex"><span style="width: 0%; background: var(--accent)"></span></span>
        <span>Video coming soon</span>
      </div>
    </div>
    <figcaption style="font-size: 14px; color: var(--muted)">Product preview: scrolling git history across six repositories in two organizations, then drilling entity → organization → repo → file.</figcaption>
  </figure>
</section>
