<section class="landing-section research" id="why" style="flex-shrink: 0; box-sizing: border-box; padding: 112px 120px; background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 48px">
